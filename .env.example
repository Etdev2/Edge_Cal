# Edge Calculator — Environment Template
# Copy to .env for local dev: cp .env.example .env

# Required: Postgres connection (Neon / Supabase / Vercel Postgres)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: BALLDONTLIE All-Star key (server-only, never NEXT_PUBLIC_)
# Get one at https://www.balldontlie.io — used only in API routes
BALLDONTLIE_API_KEY=

# Optional: public app URL for share links
NEXT_PUBLIC_APP_URL=http://localhost:3000
